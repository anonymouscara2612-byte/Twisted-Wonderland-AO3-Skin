  right: 0;
  top: 50%;
  transform: translateY(-35%);
  width: 62px;
  height: 110px;
  background-image: url("https://64.media.tumblr.com/077ad858eeb8f60a6a4af5c638f45197/8e175178ef0cbc28-bd/s1280x1920/fd32709b76f14c3c671c55f086d86f8af1c0cc7f.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " 𝕷𝖊𝖙 𝖚𝖘 𝖘𝖍𝖔𝖜 𝖞𝖔𝖚 𝖙𝖍𝖊 𝖗𝖊𝖆𝖑 𝖍𝖆𝖕𝖕𝖎𝖑𝖞-𝖊𝖛𝖊𝖗-𝖆𝖋𝖙𝖊𝖗 ";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(18px);
  border-radius: 10px;
  background: rgba(12, 11, 15, 0.7);
  text-align: center;
  font-size: 13px;
  color: #CCC4B0;
  opacity: 1;
  white-space: pre;
}

